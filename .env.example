# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model). Đã viết sẵn trong codebase/ai.py:
#   openai     · MODEL_NAME=gpt-5-mini              · key: platform.openai.com
#   openrouter · MODEL_NAME=google/gemini-2.5-flash · key: openrouter.ai/keys (một key dùng được nhiều hãng)
#   gemini     · MODEL_NAME=gemini-2.5-flash        · key: aistudio.google.com/apikey
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=

# Your personal Phoenix feed ("Nhắc lịch qua Google Calendar" on portal-cohort5.edufun.ai/events). SECRET — never commit.
PHOENIX_ICS_URL=
# Who may send the weekly timetable email (comma-separated). Empty = every email is rejected.
TKB_ALLOWED_SENDERS=
# Where leave-request drafts are addressed (program admin). Empty = the student picks the recipient in Outlook.
LEAVE_RECIPIENT=

# App database. Empty = local SQLite at data/private/app.db. Shared Neon Postgres: Dashboard → Connect → copy the
# pooled connection string (postgresql://user:password@ep-…-pooler.<region>.aws.neon.tech/dbname?sslmode=require).
# SECRET — never commit; ask the team. Move existing local data once with: python scripts/migrate_to_postgres.py
DATABASE_URL=

# Web-push signing key. Everyone on the same DATABASE_URL must use the SAME value (ask the team). SECRET.
# Solo / local only: leave empty and a key file is created in data/private/. Make one: python3 scripts/vapid_key.py
VAPID_PRIVATE_KEY=
