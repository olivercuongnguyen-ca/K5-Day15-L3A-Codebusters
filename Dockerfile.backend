FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY codebase ./codebase
COPY assets ./assets
COPY data/campus_buildings.json ./data/campus_buildings.json
COPY data/schedule_groups.json ./data/schedule_groups.json
RUN mkdir -p /app/data/private

EXPOSE 8000

CMD ["sh", "-c", "uvicorn codebase.web.server:app --host 0.0.0.0 --port ${PORT:-8000}"]
